{
  "name": "plsql-outline",
  "displayName": "PL/SQL Outline",
  "description": "PL/SQL代码结构解析器和大纲视图",
  "version": "1.17.0",
  "publisher": "EmonZhang3438",
  "icon": "res/Icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "plsql",
    "oracle",
    "sql",
    "outline",
    "parser",
    "structure"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:plsql",
    "onLanguage:sql",
    "onCommand:plsqlOutline.parseCurrentFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "plsqlOutlineContainer",
          "title": "PL/SQL大纲",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "plsqlOutlineContainer": [
        {
          "type": "webview",
          "id": "plsqlOutline",
          "name": "PLSQL Outline"
        },
        {
          "id": "plsqlOutlineBookmarks",
          "name": "书签",
          "visibility": "collapsed"
        }
      ]
    },
    "submenus": [
      {
        "id": "plsqlOutline.bookmark.menu",
        "label": "书签"
      }
    ],
    "keybindings": [
      {
        "command": "plsqlOutline.bookmark.toggle",
        "key": "ctrl+alt+k",
        "when": "editorTextFocus && resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
      },
      {
        "command": "plsqlOutline.bookmark.next",
        "key": "alt+pagedown",
        "when": "editorTextFocus && resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
      },
      {
        "command": "plsqlOutline.bookmark.previous",
        "key": "alt+pageup",
        "when": "editorTextFocus && resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
      }
    ],
    "configurationDefaults": {
      "workbench": {
        "tree": {
          "indent": 16,
          "renderIndentGuides": "always"
        }
      }
    },
    "commands": [
      {
        "command": "plsqlOutline.parseCurrentFile",
        "title": "解析当前文件",
        "category": "PL/SQL Outline",
        "icon": "$(refresh)"
      },
      {
        "command": "plsqlOutline.refresh",
        "title": "刷新",
        "category": "PL/SQL Outline",
        "icon": "$(refresh)"
      },
      {
        "command": "plsqlOutline.toggleStructureBlocks",
        "title": "切换结构块显示",
        "category": "PL/SQL Outline",
        "icon": "$(list-tree)"
      },
      {
        "command": "plsqlOutline.toggleDebugMode",
        "title": "切换调试模式",
        "category": "PL/SQL Outline",
        "icon": "$(debug)"
      },
      {
        "command": "plsqlOutline.showStats",
        "title": "显示解析统计",
        "category": "PL/SQL Outline",
        "icon": "$(graph)"
      },
      {
        "command": "plsqlOutline.exportResult",
        "title": "导出解析结果",
        "category": "PL/SQL Outline",
        "icon": "$(export)"
      },
      {
        "command": "plsqlOutline.manageFileExtensions",
        "title": "管理文件扩展名",
        "category": "PL/SQL Outline",
        "icon": "$(settings-gear)"
      },
      {
        "command": "plsqlOutline.openSettings",
        "title": "打开设置页面",
        "category": "PL/SQL Outline",
        "icon": "$(settings)"
      },
      {
        "command": "plsqlOutline.expandAll",
        "title": "展开所有",
        "category": "PL/SQL Outline",
        "icon": "$(expand-all)"
      },
      {
        "command": "plsqlOutline.rebuildIndex",
        "title": "重建符号索引",
        "category": "PL/SQL Outline",
        "icon": "$(database)"
      },
      {
        "command": "plsqlOutline.bookmark.toggle",
        "title": "切换书签（当前行）",
        "category": "PL/SQL Outline",
        "icon": "$(bookmark)"
      },
      {
        "command": "plsqlOutline.bookmark.list",
        "title": "浏览全部书签…",
        "category": "PL/SQL Outline",
        "icon": "$(list-unordered)"
      },
      {
        "command": "plsqlOutline.bookmark.next",
        "title": "下一处书签",
        "category": "PL/SQL Outline",
        "icon": "$(arrow-down)"
      },
      {
        "command": "plsqlOutline.bookmark.previous",
        "title": "上一处书签",
        "category": "PL/SQL Outline",
        "icon": "$(arrow-up)"
      },
      {
        "command": "plsqlOutline.bookmark.edit",
        "title": "编辑书签信息…",
        "category": "PL/SQL Outline",
        "icon": "$(edit)"
      },
      {
        "command": "plsqlOutline.bookmark.delete",
        "title": "删除当前行书签",
        "category": "PL/SQL Outline",
        "icon": "$(close)"
      },
      {
        "command": "plsqlOutline.bookmark.clearFile",
        "title": "清除本文件全部书签",
        "category": "PL/SQL Outline",
        "icon": "$(clear-all)"
      },
      {
        "command": "plsqlOutline.bookmark.jumpTo",
        "title": "跳转到书签",
        "category": "PL/SQL Outline"
      },
      {
        "command": "plsqlOutline.bookmark.getState",
        "title": "获取书签状态（测试）",
        "category": "PL/SQL Outline"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "plsqlOutline.refresh",
          "when": "view == plsqlOutline",
          "group": "navigation@1"
        },
        {
          "command": "plsqlOutline.expandAll",
          "when": "view == plsqlOutline",
          "group": "navigation@2"
        },
        {
          "command": "plsqlOutline.openSettings",
          "when": "view == plsqlOutline",
          "group": "navigation@5"
        },
        {
          "command": "plsqlOutline.bookmark.list",
          "when": "view == plsqlOutlineBookmarks",
          "group": "navigation@1"
        },
        {
          "command": "plsqlOutline.bookmark.clearFile",
          "when": "view == plsqlOutlineBookmarks",
          "group": "navigation@2"
        },
        {
          "command": "plsqlOutline.toggleStructureBlocks",
          "when": "view == plsqlOutline",
          "group": "1_structure@1"
        },
        {
          "command": "plsqlOutline.toggleDebugMode",
          "when": "view == plsqlOutline",
          "group": "2_debug@1"
        },
        {
          "command": "plsqlOutline.showStats",
          "when": "view == plsqlOutline",
          "group": "3_info@1"
        },
        {
          "command": "plsqlOutline.exportResult",
          "when": "view == plsqlOutline",
          "group": "3_info@2"
        }
      ],
      "view/item/context": [
        {
          "command": "plsqlOutline.bookmark.edit",
          "when": "view == plsqlOutlineBookmarks && viewItem == bookmarkItem",
          "group": "navigation@1"
        },
        {
          "command": "plsqlOutline.bookmark.delete",
          "when": "view == plsqlOutlineBookmarks && viewItem == bookmarkItem",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "plsqlOutline.parseCurrentFile",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|trg)$/i",
          "group": "plsql@1"
        },
        {
          "submenu": "plsqlOutline.bookmark.menu",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i",
          "group": "plsql@2"
        }
      ],
      "plsqlOutline.bookmark.menu": [
        {
          "command": "plsqlOutline.bookmark.toggle",
          "group": "1_actions@1"
        },
        {
          "command": "plsqlOutline.bookmark.list",
          "group": "2_navigate@1"
        },
        {
          "command": "plsqlOutline.bookmark.next",
          "group": "2_navigate@2"
        },
        {
          "command": "plsqlOutline.bookmark.previous",
          "group": "2_navigate@3"
        },
        {
          "command": "plsqlOutline.bookmark.edit",
          "group": "3_manage@1"
        },
        {
          "command": "plsqlOutline.bookmark.delete",
          "group": "3_manage@2"
        },
        {
          "command": "plsqlOutline.bookmark.clearFile",
          "group": "3_manage@3"
        }
      ],
      "commandPalette": [
        {
          "command": "plsqlOutline.parseCurrentFile",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|trg)$/i"
        },
        {
          "command": "plsqlOutline.refresh",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|trg)$/i"
        },
        {
          "command": "plsqlOutline.toggleStructureBlocks"
        },
        {
          "command": "plsqlOutline.toggleDebugMode"
        },
        {
          "command": "plsqlOutline.showStats",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|trg)$/i"
        },
        {
          "command": "plsqlOutline.exportResult",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|trg)$/i"
        },
        {
          "command": "plsqlOutline.rebuildIndex"
        },
        {
          "command": "plsqlOutline.bookmark.toggle",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
        },
        {
          "command": "plsqlOutline.bookmark.list",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
        },
        {
          "command": "plsqlOutline.bookmark.next",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
        },
        {
          "command": "plsqlOutline.bookmark.previous",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
        },
        {
          "command": "plsqlOutline.bookmark.edit",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
        },
        {
          "command": "plsqlOutline.bookmark.delete",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
        },
        {
          "command": "plsqlOutline.bookmark.clearFile",
          "when": "resourceExtname =~ /\\.(sql|pks|pkb|pck|prc|fnc|fcn|trg|typ)$/i"
        },
        {
          "command": "plsqlOutline.bookmark.jumpTo",
          "when": "false"
        },
        {
          "command": "plsqlOutline.bookmark.getState",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "PL/SQL Outline",
      "properties": {
        "plsql-outline.parsing.autoParseOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存文件时自动解析"
        },
        "plsql-outline.parsing.autoParseOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "切换到PL/SQL文件时自动解析"
        },
        "plsql-outline.parsing.maxNestingDepth": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 30,
          "description": "最大嵌套深度限制（降低以减少内存占用）"
        },
        "plsql-outline.view.showStructureBlocks": {
          "type": "boolean",
          "default": true,
          "description": "在树视图中显示结构块（BEGIN、EXCEPTION、END）"
        },
        "plsql-outline.view.expandByDefault": {
          "type": "boolean",
          "default": true,
          "description": "默认展开树节点"
        },
        "plsql-outline.view.autoSelectOnCursor": {
          "type": "boolean",
          "default": true,
          "description": "当光标位置改变时自动选中对应的大纲节点"
        },
        "plsql-outline.view.showDeclarations": {
          "type": "boolean",
          "default": true,
          "description": "在大纲 DECLARE 区域显示声明项（变量/游标/常量/类型/异常）"
        },
        "plsql-outline.view.groupDeclarations": {
          "type": "boolean",
          "default": true,
          "description": "声明项按类别分组（Variables/Cursors/Constants/Types/Exceptions）；关闭则扁平展开"
        },
        "plsql-outline.debug.enabled": {
          "type": "boolean",
          "default": false,
          "description": "启用调试模式"
        },
        "plsql-outline.debug.logLevel": {
          "type": "string",
          "enum": [
            "ERROR",
            "WARN",
            "INFO",
            "DEBUG"
          ],
          "default": "INFO",
          "description": "日志级别"
        },
        "plsql-outline.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".sql",
            ".fnc",
            ".fcn",
            ".prc",
            ".pks",
            ".pkb",
            ".pck",
            ".typ"
          ],
          "description": "支持解析的文件扩展名列表"
        },
        "plsql-outline.codeRepository.paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "代码仓库路径"
              },
              "priority": {
                "type": "number",
                "description": "优先级（数字越小优先级越高）",
                "default": 1
              }
            },
            "required": [
              "path"
            ]
          },
          "default": [],
          "maxItems": 2,
          "description": "代码仓库路径配置（最多2个，优先级高的路径找到定义后不再搜索低优先级路径）"
        },
        "plsql-outline.codeRepository.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".sql",
            ".fnc",
            ".fcn",
            ".prc",
            ".pks",
            ".pkb",
            ".pck",
            ".typ"
          ],
          "description": "符号索引扫描的文件扩展名"
        },
        "plsql-outline.codeRepository.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "扩展启动时自动构建符号索引"
        },
        "plsql-outline.codeRepository.maxFiles": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 20000,
          "description": "符号索引最大扫描文件数"
        }
      }
    },
    "languages": [
      {
        "id": "plsql",
        "aliases": [
          "PL/SQL",
          "plsql"
        ],
        "extensions": [
          ".pks",
          ".pkb",
          ".pck",
          ".prc",
          ".fnc",
          ".trg"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node tests/unit/run_all.js",
    "test:regression": "node tests/regression/run_all.js",
    "test:corpus": "node tests/corpus/validate.js && node tests/corpus/render-validate.js",
    "test:e2e": "node tests/e2e/anonDefinition.e2e.test.js && node tests/e2e/zcodetest_smoke.e2e.js && node tests/e2e/foldRouting.e2e.test.js && node tests/e2e/indexJump.e2e.test.js && node tests/e2e/bookmark.e2e.test.js",
    "package": "vsce package -o release/",
    "publish": "vsce publish",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.15.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Emon9426/plsql-outline.git"
  },
  "bugs": {
    "url": "https://github.com/Emon9426/plsql-outline/issues"
  },
  "homepage": "https://github.com/Emon9426/plsql-outline#readme",
  "license": "MIT"
}
